{
    "permissions": {
        "allow": [
            "Bash(mkdir:*)",
            "Bash(uv:*)",
            "Bash(find:*)",
            "Bash(mv:*)",
            "Bash(grep:*)",
            "Bash(npm:*)",
            "Bash(ls:*)",
            "Bash(cp:*)",
            "Write",
            "Edit",
            "Bash(chmod:*)",
            "Bash(touch:*)"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(**/secrets/*)",
            "Read(**/*credential*)",
            "Read(**/*.pem)",
            "Read(**/*.key)"
        ]
    },
    "statusLine": {
        "type": "command",
        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/status_lines/status_line_v6.py",
        "padding": 0
    },
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/post_tool_use.py"
                    }
                ]
            },
            {
                "matcher": "Write|Edit|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/validator/ruff_validator.py",
                        "statusMessage": "Running ruff format..."
                    },
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/validator/ty_validator.py",
                        "statusMessage": "Running ty validator..."
                    },
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/validator/ts_lint.py",
                        "statusMessage": "Running ESLint linter..."
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "",
                "hooks": [
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py"
                    },
                    {
                        "type": "command",
                        "command": "uv run $CLAUDE_PROJECT_DIR/.claude/hooks/use_bun.py"
                    }
                ]
            }
        ]
    }
}